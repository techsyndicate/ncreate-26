<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <style>
      body {
        user-select: none;
      }
      .pre-dabba {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #000a11;
        font-size: 3vw;
        opacity: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        animation-name: fadeInOut;
        animation-duration: 2s;
        animation-fill-mode: forwards;
        text-align: center;
      }
      .dabba {
        flex: 1;
        border: 0.2vh solid #a1c7e7;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: relative;
        opacity: 0;
        animation-name: fadeIn;
        animation-fill-mode: forwards;
        animation-duration: 1s;
        animation-delay: 4s;
      }
      .circle {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -53%);
        height: 70vh;
        animation-name: ghoomar;
        animation-duration: 15s;
        animation-iteration-count: infinite;
        animation-timing-function: linear;
      }
      .baymax-text {
        width: 20vw;
        margin-top: 2.5vw;
        margin-left: 2vw;
      }
      #baymax {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -48%);
        width: 100vh;
        height: 100vh;
        z-index: 3;
      }

      .codeDabbaContainer {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        position: absolute;
        top: 0;
        right: 0;
      }
      .codeDabba {
        border-left: 0.1vw solid #a1c7e7;
        border-bottom: 0.1vw solid #a1c7e7;
      }
      .codeDabbaHeading {
        background: #a1c7e7;
        padding: 0.6vw;
        color: black;
        font-size: 0.85vw;
      }
      .code {
        color: rgba(255, 255, 255, 0.6);
        padding: 0.8vw;
        font-size: 0.65vw;
      }
      .code pre {
        margin: 0px;
        overflow-wrap: break-word;
        white-space: break-spaces;
      }

      .graphs {
        position: absolute;
        bottom: 0;
        right: 0;
        padding-bottom: 3vw;
        padding-right: 4vw;
      }
      .graph {
        margin-top: 1.5vw;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .graph p {
        margin: 0.4vw 0 0;
        font-size: 0.7vw;
      }
      .graph-box {
        border: 0.2vw solid #a1c7e7;
        position: relative;
      }
      .grid-row {
        display: flex;
      }
      .grid-box {
        border: 0.1vw solid #a1c7e7;
        width: 2.2vw;
        height: 2vw;
      }
      .graph-bars {
        position: absolute;
        left: 0;
        bottom: 0;
        display: flex;
        align-items: flex-end;
      }
      .graph-bar {
        background: #66b9ff;
        border-top: 0.2vw solid #a1c7e7;
        border-left: 0.1vw solid #a1c7e7;
        border-right: 0.1vw solid #a1c7e7;
        width: 2.2vw;
        animation-name: uth;
        animation-duration: 0.9s;
        animation-fill-mode: forwards;
        animation-delay: 4s;
      }
      .muth-circle {
        position: absolute;
        z-index: 2;
        height: 21.5vh;
        width: 21.5vh;
        top: 68.5vh;
        left: 50%;
        transform: translate(calc(-50% - 21.5vh), -50%);
        border-radius: 100vw;
        background: #000a11;
      }
      .muth-circle-border {
        background: transparent;
        border: 0.1vw solid #a1c7e7;
        z-index: 4;
      }
      .muth-side-circle {
        height: 2vh;
        width: 2vh;
        transform: translate(calc(-50% - 33.2vh), -50%);
        background: #a1c7e7;
      }
      .muth-text {
        padding: 1.3vh 2vh;
        background: #a1c7e7;
        color: black;
        height: auto;
        width: auto;
        transform: translate(calc(-50% - 41.2vh), -50%);
        font-size: 1.9vh;
        cursor: pointer;
        transition: 0.2s;
        z-index: 20;
      }
      .muth-text:hover {
        transform: translate(calc(-50% - 41.2vh), -50%) scale(1.05);
      }
      .anim-button {
        width: 7vw;
        height: 7vw;
        background: #a1c7e7;
        border-radius: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        font-size: 1.1vw;
        color: black;
      }
      .anim-button:hover {
        transform: scale(1.05);
      }

      @keyframes ghoomar {
        0% {
          transform: translate(-50%, -53%) rotate(0deg);
        }
        100% {
          transform: translate(-50%, -53%) rotate(360deg);
        }
      }
      @keyframes uth {
        0% {
          height: 0vw;
        }
      }
      @keyframes fadeIn {
        0% {
          opacity: 0;
        }
        100% {
          opacity: 1;
        }
      }
      @keyframes fadeInOut {
        0% {
          opacity: 0;
        }
        75% {
          opacity: 1;
        }
        100% {
          opacity: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="pre-dabba">Hello. I'm Baymax.</div>
    <div class="pre-dabba" style="animation-delay: 2s">
      Your personal healthcare<br />companion.
    </div>
    <div class="dabba">
      <%- include('./partials/navbar.ejs', {active: 1}) %>
      <img src="./elements/circle.png" class="circle" />
      <img src="./elements/baymax-text.png" class="baymax-text" />
      <canvas id="baymax"></canvas>

      <div class="codeDabbaContainer">
        <div class="codeDabba" style="width: 13vw">
          <div class="code">
            <pre>
return NextResponse.json({
    message: "Hi",
    success: true,
    name: "Baymax",
    age: Infinity,
    gender: "/"
  });</pre
            >
          </div>
        </div>
        <div class="codeDabba" style="width: 20vw">
          <div class="codeDabbaHeading">helloWorld.tsx</div>
          <div class="code">
            <pre>
import { connect } from "@/dbConfig/dbConfig";
import User from "@/models/userModel";
import { NextRequest, NextResponse } from "next/server";
import Ticket from "@/models/ticketModel";

connect();

const createTicketId = () => {
    const random = Math.floor(Math.random() * Math.pow(10, 14)).toString();
    const arr = random.split("");
    return "#" + arr.join("");
};
              </pre
            >
          </div>
        </div>
      </div>

      <div class="graphs">
        <div class="graph">
          <div class="graph-box">
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="graph-bars">
              <div
                class="graph-bar"
                style="height: 1.4vw; border-left: none"
              ></div>
              <div class="graph-bar" style="height: 6.4vw"></div>
              <div class="graph-bar" style="height: 4.9vw"></div>
              <div
                class="graph-bar"
                style="height: 3.5vw; border-right: none"
              ></div>
            </div>
          </div>
          <p>Battery</p>
        </div>
        <div class="graph">
          <div class="graph-box">
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="grid-row">
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
              <div class="grid-box"></div>
            </div>
            <div class="graph-bars">
              <div
                class="graph-bar"
                style="height: 4.5vw; border-left: none"
              ></div>
              <div class="graph-bar" style="height: 2.9vw"></div>
              <div class="graph-bar" style="height: 6.4vw"></div>
              <div
                class="graph-bar"
                style="height: 5vw; border-right: none"
              ></div>
            </div>
          </div>
          <p>Stamina</p>
        </div>
      </div>
      <div id="muth" style="transition: 0.4s">
        <div class="muth-circle"></div>
        <div class="muth-circle muth-circle-border"></div>
        <div class="muth-circle muth-side-circle"></div>
        <div
          class="muth-circle muth-text"
          onclick="playAnimation('FistBump', true)"
        >
          FIST BUMP
        </div>
      </div>

      <div
        style="
          display: flex;
          align-items: center;
          margin-left: 2vw;
          padding-top: 1vw;
        "
      >
        <p style="font-size: 1vw; margin: 0px">Battery:-</p>
        <img
          src="./icons/battery.png"
          style="height: 1vw; margin-left: 0.5vw"
        />
      </div>

      <div style="display: flex; gap: 1vw; margin: 2vw 0 0 3vw">
        <div class="anim-button" onclick="playAnimation('Wave', true)">Wave</div>
        <div class="anim-button" onclick="playAnimation('Punch', true)">Punch</div>
      </div>
    </div>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
        }
      }
    </script>
    <script src="./js/baymax.js" type="module"></script>
  </body>
</html>
