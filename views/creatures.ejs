<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Creatures</title>
    <style>
      body {
        user-select: none;
      }
      .main {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100vw;
        height: 100vh;
        justify-content: flex-end;
        position: fixed;
        top: 0;
        left: 0;
        padding-bottom: 5vw;
      }
      .creatures {
        display: flex;
        gap: 4vw;
        align-items: center;
      }
      .circle-inactive {
        width: 12vw;
        height: 12vw;
        border: 1px solid #636363;
        border-radius: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        cursor: pointer;
      }
      .circle-inactive:hover {
        transform: scale(1.06);
      }

      .circle-active {
        width: 14vw;
        height: 14vw;
        border: 1px solid red;
        border-radius: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        cursor: pointer;
      }
      .circle-active:hover {
        transform: scale(1.06);
      }
      .shake {
        animation-name: shake;
        animation-duration: 0.5s;
        animation-iteration-count: 2;
      }

      .circle-inactive img {
        height: 8vw;
      }
      .circle-active img {
        height: 10vw;
      }

      .tobu-text {
        margin: 3vw 0;
        height: 5vw;
      }
      .actions {
        display: flex;
        gap: 2vw;
        font-size: 1.1vw;
      }
      .actions p {
        margin: 0px;
      }
      .action {
        cursor: pointer;
        transition: 0.2s;
      }
      .action:hover {
        color: red;
      }

      .hand {
        width: 8vw;
        height: 8vw;
        position: fixed;
        z-index: 5;
        pointer-events: none;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
      }

      .pet {
        animation: pet;
        animation-duration: 0.5s;
        animation-fill-mode: forwards;
      }

      @keyframes pet {
        0% {
          transform: translate(-50%, -90%);
          opacity: 1;
        }
        100% {
          transform: translate(-50%, -50%);
          opacity: 0;
        }
      }
      @keyframes shake {
        0% {
          transform: translate(1px, 1px) rotate(0deg);
        }
        10% {
          transform: translate(-1px, -2px) rotate(-1deg);
        }
        20% {
          transform: translate(-3px, 0px) rotate(1deg);
        }
        30% {
          transform: translate(3px, 2px) rotate(0deg);
        }
        40% {
          transform: translate(1px, -1px) rotate(1deg);
        }
        50% {
          transform: translate(-1px, 2px) rotate(-1deg);
        }
        60% {
          transform: translate(-3px, 1px) rotate(0deg);
        }
        70% {
          transform: translate(3px, 1px) rotate(-1deg);
        }
        80% {
          transform: translate(-1px, -1px) rotate(1deg);
        }
        90% {
          transform: translate(1px, 2px) rotate(0deg);
        }
        100% {
          transform: translate(1px, -2px) rotate(-1deg);
        }
      }
    </style>
  </head>
  <body>
    <%- include('./partials/navbar-2', {active: 3}) %>
    <div class="main">
      <div class="creatures">
        <div class="circle-inactive" onclick="switchToCreature(1)">
          <img src="./elements/creature-1.png" />
        </div>
        <div class="circle-active" onclick="switchToCreature(2)">
          <img src="./elements/creature-2.png" />
        </div>
        <div class="circle-inactive" onclick="switchToCreature(3)">
          <img src="./elements/creature-3.png" />
        </div>
      </div>
      <img src="./elements/tobu-text.png" class="tobu-text" />
      <div class="actions">
        <p class="action" onclick="eatIt()">EAT</p>
        <p>/</p>
        <p class="action" onclick="enrage()">ENRAGE</p>
        <p>/</p>
        <p class="action" onclick="pet()">PET</p>
      </div>
    </div>
    <img src="./elements/hand.png" class="hand" />
    <script>
      const container = document.querySelector(".creatures");
      const circles = Array.from(container.children);
      var numClicked = 0;
      var selectedCircle = circles.find((circle) =>
        circle.classList.contains("circle-active")
      );
      const eat = new Audio("audio/mc-eat.mp3");
      function eatIt() {
        eat.currentTime = 0;
        eat.play();
      }
      function switchToCreature(creature) {
        selectedCircle = circles.find((circle) =>
          circle.querySelector("img").src.includes(`creature-${creature}.png`)
        );
        if (!selectedCircle) return;
        circles.forEach((circle) => {
          circle.classList.toggle("circle-active", circle === selectedCircle);
          circle.classList.toggle("circle-inactive", circle !== selectedCircle);
        });
        const otherCircles = circles.filter(
          (circle) => circle !== selectedCircle
        );
        container.replaceChildren(
          otherCircles[0],
          selectedCircle,
          otherCircles[1]
        );
      }

      function enrage() {
        numClicked += 1;
        if (numClicked >= 5) {
          document.querySelector(".main").style.transition = "0.5s";
          document.querySelector(".main").style.opacity = "0";
          setTimeout(() => {
            window.location.href = "/mutiny";
          }, 500);
        }
        if (selectedCircle) {
          selectedCircle.classList.add("shake");
          setTimeout(() => {
            selectedCircle.classList.remove("shake");
          }, 1000);
        }
      }

      function pet() {
        const hand = document.querySelector(".hand");
        hand.classList.add("pet");
        setTimeout(() => {
          hand.classList.remove("pet");
        }, 500);
      }
    </script>
  </body>
</html>
