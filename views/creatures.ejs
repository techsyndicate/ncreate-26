    <style>
      body {
        user-select: none;
      }
      .navbar {
        transition: 0.3s;
      }
      .main {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100vw;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        padding: 1vw;
      }
      .button {
        border: 0.1vw solid red;
        border-radius: 100vw;
        padding: 0.7vw 1.5vw;
        font-size: 1.3vw;
        transition: 0.3s;
        cursor: pointer;
      }
      .button:hover {
        background: red;
        color: black;
      }
      .HOSHIYAR {
        background: rgb(160, 5, 5);
        color: white;
        width: 100%;
        height: 100%;
        border-radius: 1vw;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        flex-direction: column;
      }
      .HOSHIYAR h1 {
        font-size: 3.1vw;
        margin: 0;
        color: rgb(220, 220, 36);
      }
      .HOSHIYAR p {
        font-size: 1.5vw;
        width: 60%;
        margin: 2vw 0 0 0;
      }
      .gamebox {
        /* border: 0.2vw solid rgb(160, 5, 5); */
        background: rgb(160, 5, 5);
        border-radius: 1vw;
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
      }
      .nextBtn {
        display: flex;
        gap: 0.8vw;
        font-size: 1.4vw;
        margin-top: 2vw;
        color: rgb(220, 220, 36);
        opacity: 0;
        align-items: center;
        cursor: pointer;
      }
      .triangle {
        width: 0.9vw;
        height: 0.7vw;
        background: rgb(220, 202, 36);
        clip-path: polygon(0 0, 100% 50%, 0 100%);
      }
      .nextBtn * {
        animation-name: blink;
        animation-duration: 0.4s;
        animation-iteration-count: infinite;
      }
      .microbot {
        height: 7vw;
      }
      .microbot-container {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
      }
      .arrow {
        position: absolute;
        bottom: 3.5vw;
        background: black;
        left: 50%;
        transform: translateX(-50%);
        width: 0.2vw;
        height: 10vw;
        z-index: 40;
        transform-origin: bottom center;
      }
      .arrow::after {
        content: "";
        position: absolute;
        top: -1vw;
        left: 50%;
        transform: translateX(-50%);
        width: 1vw;
        height: 1vw;
        background: black;
        clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      }
      .score {
        position: absolute;
        top: 0;
        right: 0;
        background: rgba(50, 50, 50, 0.8);
        padding: 1vw 1.5vw;
        z-index: 1000;
        font-size: 1.2vw;
      }

      @keyframes blink {
        0% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
        100% {
          opacity: 1;
        }
      }
    </style>
  </head>
  <body>
    <%- include("./partials/navbar-2.ejs", { active: 3 }) %>
