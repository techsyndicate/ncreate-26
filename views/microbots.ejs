<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Microbots</title>
    <style>
      .main {
        display: flex;
        flex: 1;
      }
      .left {
        margin: 1.5vw 0 0vw 2vw;
        display: flex;
        flex-direction: column;
        margin-bottom: 1.5vw;
      }
      .shapes-text {
        height: 4.6vw;
      }
      .left-inner {
        width: 18vw;
        display: flex;
        flex-direction: column;
        gap: 2vw;
        margin-top: 1vw;
        flex: 1;
      }
      .circle {
        width: 7.5vw;
        height: 7.5vw;
        border: 1px solid red;
        border-radius: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .icon {
        height: 3.25vw;
        width: auto;
      }

      .middle {
        flex: 1;
        margin: 1.5vw 2vw 1.5vw 0vw;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .japanese {
        width: 40vw;
      }

      .right {
        margin-top: 1.5vw;
        margin-right: 2vw;
        position: relative;
        width: 20vw;
      }
      .stats-text {
        height: 4.6vw;
        position: absolute;
        right: 0;
        top: 0;
      }
    </style>
  </head>
  <body>
    <%- include('./partials/navbar-2', {active: 2}) %>
    <div class="main">
      <div class="left">
        <img src="./elements/shapes-text.png" class="shapes-text" />
        <div class="left-inner">
          <div
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
            "
          >
            <div class="circle">
              <img src="./icons/cube.png" class="icon" />
            </div>
            <div class="circle">
              <img src="./icons/circle.png" class="icon" />
            </div>
          </div>
          <div
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
            "
          >
            <div class="circle">
              <img src="./icons/pyramid.png" class="icon" />
            </div>
            <div class="circle">
              <img src="./icons/cylinder.png" class="icon" />
            </div>
          </div>
          <div style="border: 1px solid red; flex: 1; border-radius: 2vw">
            <p
              style="
                text-align: center;
                font-size: 1.1vw;
                margin: 0px;
                margin-top: 1.2vw;
              "
            >
              DRAW CUSTOM SHAPE
            </p>
          </div>
        </div>
      </div>
      <div class="middle">
        <p style="margin: 0px; margin-bottom: 0.5vw; text-align: center; font-size: 1.1vw;">control</p>
        <p style="margin: 0px; margin-bottom: 0.5vw; text-align: center; font-size: 1.1vw; color: red;">[MICROBOTS]</p>
        <img src="./elements/japanese-circle-shit.png" class="japanese">
        <img src="./elements/microbot-filler.png" class="microbot">
      </div>
      <div class="right">
        <img src="./elements/statistics-text.png" class="stats-text">
      </div>
    </div>
  </body>
</html>
