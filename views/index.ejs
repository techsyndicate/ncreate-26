<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Choose Profile</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Geist+Mono:ital,wght@0,100..900;1,100..900&family=Pixelify+Sans:wght@400..700&display=swap");
      body {
        margin: 0;
        width: 100vw;
        height: 100vh;
        font-family: "Geist Mono", monospace;
        color: white;
        overflow: hidden;
      }
      .bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        z-index: -1;
      }
      .navbar {
        margin: 1vw 0 0 1vw;
        display: flex;
        align-items: center;
        position: relative;
        z-index: 15;
      }
      .nav {
        border: 1px solid #6c6c6c;
        border-radius: 100vw;
        padding: 0.5vw 1vw;
        text-decoration: none;
        color: white;
        font-size: 1vw;
        background: linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.22) 0%,
          rgba(76, 76, 76, 0.22) 100%
        );
        backdrop-filter: blur(5.45px);
        transition: 0.2s;
      }
      .nav:hover {
        border: 1px solid red;
      }
      .line {
        height: 0.1vw;
        width: 1.5vw;
        background: #6c6c6c;
      }
      .hiro {
        position: fixed;
        right: 3vw;
        bottom: -6vw;
        width: 30vw;
        height: auto;
        min-width: 30vw;
        min-height: 50vh;
        max-height: 80vh;
        z-index: 5;
        transition: 0.2s;
        cursor: pointer;
      }
      .hiro-main {
        width: 27vw;
        height: auto;
        min-width: 27vw;
        max-width: 52vw;
        left: 1.5vw;
        top: 2.5vw;
        position: absolute;
        min-height: 45vh;
        max-height: 72vh;
        z-index: 6;
      }
      .hiro-border {
        width: 30vw;
        height: auto;
        min-width: 30vw;
        max-width: 60vw;
        min-height: 50vh;
        max-height: 80vh;
        transition: 0.2s;
        z-index: 7;
        position: relative;
      }
      .hiro-border:hover {
        filter: brightness(0) saturate(100%) invert(15%) sepia(92%)
          saturate(4500%) hue-rotate(245deg) brightness(95%) contrast(50%);
      }
      .hiro:has(.hiro-border:hover) {
        transform: scale(1.02);
      }
      .baymax {
        position: fixed;
        left: -4vw;
        top: -10vh;
        width: 100vw;
        min-width: 100vw;
        max-width: 120vw;
        min-height: 110vh;
        transition: 0.2s;
        cursor: pointer;
      }
      .baymax-main {
        width: 99vw;
        min-width: 99vw;
        max-width: 120vw;
        min-height: 108vh;
        left: -1vw;
        top: 2.5vw;
        position: absolute;
        z-index: 2;
      }
      .baymax-border {
        width: 100vw;
        min-width: 100vw;
        max-width: 120vw;
        min-height: 110vh;
        position: relative;
        z-index: 3;
        transition: 0.2s;
      }
      .baymax-border:hover {
        filter: brightness(0) saturate(100%) invert(12%) sepia(100%)
          saturate(7483%) hue-rotate(25deg) brightness(103%) contrast(85%);
      }
      .baymax:has(.baymax-border:hover) {
        transform: scale(1.02);
      }
      .profile {
        position: fixed;
        top: 0vw;
        right: 0vw;
        z-index: 10;
        width: 33.5vw;
        pointer-events: none;
      }
      .baymax-banner {
        position: absolute;
        width: 17vw;
        top: 43vw;
        left: 37vw;
        z-index: 4;
        pointer-events: none;
      }
      .hiro-banner {
        position: absolute;
        width: 15vw;
        bottom: 9vw;
        left: 1vw;
        z-index: 9;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <img src="./elements/fransokyo-bg.png" class="bg" />
    <div class="navbar">
      <a class="nav" href="#" style="border: 1px solid red">/DASHBOARD</a>
      <div class="line"></div>
      <a class="nav" href="#">/MICROBOTS</a>
      <div class="line"></div>
      <a class="nav" href="#">/CREATURES</a>
      <div class="line"></div>
      <a class="nav" href="#">/JOURNAL</a>
    </div>
    <div class="hiro">
      <img src="./elements/hiro-home.png" class="hiro-main" />
      <img src="./elements/hiro-home-border.png" class="hiro-border" />
      <img src="./elements/hiro-banner.png" class="hiro-banner" />
    </div>
    <div class="baymax" onclick="window.location.href = '/baymax'">
      <img src="./elements/baymax-home.png" class="baymax-main" />
      <img src="./elements/baymax-home-border.png" class="baymax-border" />
      <img src="./elements/baymax-banner.png" class="baymax-banner" />
    </div>
    <img src="./elements/select-profile.png" class="profile">
  </body>
</html>
