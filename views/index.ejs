<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Choose Profile</title>
    <style>
      * {transition: 0.3s;}
      .bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        z-index: -1;
      }
      .hiro {
        position: fixed;
        right: 3vw;
        bottom: -6vw;
        width: 30vw;
        height: auto;
        min-width: 30vw;
        min-height: 50vh;
        max-height: 80vh;
        z-index: 5;
        transition: 0.2s;
        cursor: pointer;
      }
      .hiro-main {
        width: 27vw;
        height: auto;
        min-width: 27vw;
        max-width: 52vw;
        left: 1.5vw;
        top: 2.5vw;
        position: absolute;
        min-height: 45vh;
        max-height: 72vh;
        z-index: 6;
      }
      .hiro-border {
        width: 30vw;
        height: auto;
        min-width: 30vw;
        max-width: 60vw;
        min-height: 50vh;
        max-height: 80vh;
        transition: 0.2s;
        z-index: 7;
        position: relative;
      }
      .hiro-border:hover {
        filter: brightness(0) saturate(100%) invert(15%) sepia(92%)
          saturate(4500%) hue-rotate(-115deg) brightness(95%) contrast(50%);
      }
      .hiro:has(.hiro-border:hover) {
        transform: scale(1.02);
      }
      .baymax {
        position: fixed;
        left: -4vw;
        top: -10vh;
        width: 100vw;
        min-width: 100vw;
        max-width: 120vw;
        min-height: 110vh;
        transition: 0.2s;
        cursor: pointer;
      }
      .baymax-main {
        width: 99vw;
        min-width: 99vw;
        max-width: 120vw;
        min-height: 108vh;
        left: -1vw;
        top: 2.5vw;
        position: absolute;
        z-index: 2;
      }
      .baymax-border {
        width: 100vw;
        min-width: 100vw;
        max-width: 120vw;
        min-height: 110vh;
        position: relative;
        z-index: 3;
        transition: 0.2s;
      }
      .baymax-border:hover {
        filter: brightness(0) saturate(100%) invert(12%) sepia(100%)
          saturate(7483%) hue-rotate(25deg) brightness(103%) contrast(85%);
      }
      .baymax:has(.baymax-border:hover) {
        transform: scale(1.02);
      }
      .profile {
        position: fixed;
        top: 0vw;
        right: 0vw;
        z-index: 10;
        width: 33.5vw;
        pointer-events: none;
      }
      .baymax-banner {
        position: absolute;
        width: 17vw;
        top: 43vw;
        left: 37vw;
        z-index: 4;
        pointer-events: none;
      }
      .hiro-banner {
        position: absolute;
        width: 15vw;
        bottom: 9vw;
        left: 1vw;
        z-index: 9;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <img src="./elements/fransokyo-bg.png" class="bg" id="bg" />
    <%- include("./partials/navbar-2", { active: 1 }) %>
    <div class="hiro" onclick="redirectTo('hiro')" id="hiro">
      <img src="./elements/hiro-home.png" class="hiro-main" />
      <img src="./elements/hiro-home-border.png" class="hiro-border" />
      <img src="./elements/hiro-banner.png" class="hiro-banner" />
    </div>
    <div class="baymax" onclick="redirectTo('baymax')" id="baymax">
      <img src="./elements/baymax-home.png" class="baymax-main" />
      <img src="./elements/baymax-home-border.png" class="baymax-border" />
      <img src="./elements/baymax-banner.png" class="baymax-banner" />
    </div>
    <img src="./elements/select-profile.png" class="profile" id="profile">

    <script>
      function redirectTo(name) {
        document.getElementById("navbar").style.transform = "translateY(-6vw)";
        document.getElementById("bg").style.opacity = "0";
        document.getElementById("profile").style.opacity = "0";
        if (name == "baymax") {
          document.getElementById("hiro").style.opacity = "0"
          setTimeout(() => {
            document.getElementById("baymax").style.transition = "0.7s";
            document.getElementById("baymax").style.transform = "translateY(150vh)";
            setTimeout(() => {window.location.href = '/baymax'}, 700)
          }, 400)
        }
        if (name == "hiro") {
          document.getElementById("baymax").style.opacity = "0"
          setTimeout(() => {
            document.getElementById("hiro").style.transition = "0.7s";
            document.getElementById("hiro").style.transform = "translateY(150vh)";
            setTimeout(() => {window.location.href = '/hiro'}, 700)
          }, 400)
        }
      }
    </script>
  </body>
</html>
